# Copy this file to .env.local for local work. On Vercel, add the same four
# names under Project Settings > Environment Variables.

# Supabase: Project Settings > API Keys (or the Connect button).
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The publishable key (sb_publishable_...). Safe to expose; row-level security protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# The secret key (sb_secret_...). Server only. Never prefix it with NEXT_PUBLIC_
# and never put it in the Android app.
SUPABASE_SECRET_KEY=sb_secret_...

# A passphrase only you know. Required to start a new care page, so strangers
# who find the site can't make it send texts. Pick something long.
BEDSIDE_SETUP_CODE=choose-a-long-passphrase
